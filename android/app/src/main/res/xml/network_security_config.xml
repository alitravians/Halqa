<?xml version="1.0" encoding="utf-8"?>
<!--
    Release / production network security config.

    Forbids cleartext traffic to every domain — Halqa only ever talks
    to `halqa-backend.vercel.app` (HTTPS) and `halqa.livekit.cloud`
    (WSS), both pinned via BuildConfig in `app/build.gradle.kts`. A
    user's phone running a release build has no business making a
    cleartext request to anything; if a future feature needs to,
    that's a deliberate decision that should land here as a scoped
    `<domain-config>` rather than the previous "allow loopback for
    everyone" wildcard.

    The debug-only loopback exceptions (`10.0.2.2`, `localhost`) live
    in `src/debug/res/xml/network_security_config.xml`, which the
    Android Gradle Plugin substitutes into the merged manifest only
    when assembling the `debug` variant. See the AOSP security config
    inheritance docs:
        https://developer.android.com/training/articles/security-config
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
