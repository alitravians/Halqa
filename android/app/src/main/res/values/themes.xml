<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Halqa" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowTranslucentNavigation">false</item>
        <item name="android:windowBackground">@color/halqa_bg</item>
    </style>

    <!-- Splash base style for API < 31. The Android 12+ splash attributes
         (windowSplashScreenBackground / windowSplashScreenAnimatedIcon) live in
         values-v31/themes.xml so lint doesn't error on min-SDK devices. -->
    <style name="Theme.Halqa.Splash" parent="Theme.Halqa">
        <item name="android:windowBackground">@color/halqa_bg</item>
    </style>
</resources>
