<?xml version="1.0" encoding="utf-8"?>
<!--
    Debug-only network security config.

    This file replaces `src/main/res/xml/network_security_config.xml`
    when the app is built with the `debug` build type. It carries the
    cleartext exceptions for the Android emulator host loopback
    (`10.0.2.2`) and the device-side `localhost` so that an engineer
    pointing the app at a locally-running Next.js backend (`npm run
    dev` on http://localhost:3000) can actually reach it without
    swapping the build config to a remote URL.

    The release variant uses the stricter `src/main/res/xml/network
    _security_config.xml` which has NO `<domain-config>` block and
    forbids cleartext to ANY domain. Splitting the configs this way
    is the AOSP-recommended pattern for this exact use-case (cf.
    https://developer.android.com/training/articles/security-config
    #ConfigInheritance) — without the split, a release APK shipping
    to real users would silently retain the cleartext loopback rule,
    which is dead code on a user's phone but a defence-in-depth gap
    that a security audit will (correctly) flag.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">localhost</domain>
    </domain-config>
</network-security-config>
