{
  "name": "halqa-functions",
  "version": "0.1.0",
  "description": "Halqa Firebase Cloud Functions — stream-watchdog Scheduled Function (PR-N).",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase --config ../firebase.json emulators:start --only functions",
    "shell": "npm run build && firebase --config ../firebase.json functions:shell",
    "start": "npm run shell",
    "deploy": "firebase --config ../firebase.json deploy --only functions",
    "logs": "firebase --config ../firebase.json functions:log",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^6.0.1"
  },
  "devDependencies": {
    "typescript": "^5.5.0"
  }
}
