rules_version = '2';

// Halqa Firestore security rules — PDPL-compliant.
// Schema overview:
//   /users/{uid}                            user-owned profile, role mutable only by staff+
//   /users/{uid}/settings/{doc}             user-owned settings (private)
//   /users/{uid}/audit/{id}                 per-user audit log; server writes
//   /users/{uid}/giftBlocklist/{senderUid}  host-owned read+write; server reads in gift txn
//   /kyc_submissions/{uid}                  user creates own, immutable except for status (staff)
//   /streams/{streamId}                     anyone authenticated can read live, server-only writes
//   /streams/{streamId}/chat/{messageId}    signed-in read; server-only writes (moderation gate)
//   /streams/{streamId}/gifts/{giftId}      sender + host + staff read; server-only writes
//   /wallets/{uid}                          owner + staff read; server-only writes
//   /audit_log/{id}                         server-only writes; staff reads all
//   /staff_actions/{id}                     staff writes, admin deletes, owner reads own targeting
//   /bans/{banId}                           server-only writes; user reads own
//
// All writes require authentication. Public reads are scoped to live streams only.
// Default-deny is in effect: any collection NOT listed here is unreadable + unwritable
// from the client. Server-side Admin SDK calls bypass these rules entirely.

service cloud.firestore {
  match /databases/{database}/documents {

    // -------- helpers --------
    function isSignedIn() {
      return request.auth != null;
    }
    function uid() {
      return request.auth.uid;
    }
    function isOwner(ownerUid) {
      return isSignedIn() && uid() == ownerUid;
    }
    function userRole() {
      return isSignedIn()
        ? get(/databases/$(database)/documents/users/$(uid())).data.role
        : 'guest';
    }
    function hasRole(rolesAllowed) {
      return userRole() in rolesAllowed;
    }
    function isStaff()      { return hasRole(['staff', 'admin']); }
    function isModerator()  { return hasRole(['moderator', 'staff', 'admin']); }
    function isAdmin()      { return userRole() == 'admin'; }

    // -------- /users/{uid} --------
    match /users/{userId} {
      allow read: if isSignedIn() && (uid() == userId || isStaff());

      // user can create own doc on first sign-in (server-side or client-side)
      allow create: if isOwner(userId)
        && request.resource.data.role == 'user'
        && request.resource.data.uid == userId;

      // user can update profile fields. role/createdAt/uid stay immutable on
      // the self-update path so a regular user can never tamper with their
      // own privilege markers.
      allow update: if isOwner(userId)
        && request.resource.data.role == resource.data.role
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt;

      // staff can promote/demote OTHER users for moderation tooling, but
      // never themselves (blocks the self-escalation `staff -> admin`
      // foot-gun) and never beyond `staff` (granting `admin` is reserved
      // for an existing admin via the rule below). uid + createdAt remain
      // immutable so audit trails stay intact.
      allow update: if isStaff()
        && uid() != userId
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.role in ['user', 'scout', 'moderator', 'staff'];

      // admin can update any user (including themselves) and grant any
      // role. uid + createdAt are still immutable.
      allow update: if isAdmin()
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt;

      // admin only delete
      allow delete: if isAdmin();

      // -------- /users/{uid}/settings/{doc} (subcollection) --------
      // Owner reads via the Firestore SDK in real time
      // ([UserRepository.observeSettings]); writes ALWAYS go through
      // the backend at POST /api/settings, which validates field
      // types + enum membership (language ∈ {ar,en}, theme ∈
      // {light,dark,auto}, etc.) before persisting. If clients were
      // allowed to write directly they would bypass that validation
      // and could store junk values that the Android UI then has to
      // defensively `as? String` around — and a malicious user could
      // burn quota by writing arbitrary unbounded fields. Closing
      // both holes by routing every write through the backend.
      match /settings/{settingDoc} {
        allow read: if isOwner(userId);
        allow write: if false; // server-only via /api/settings
      }

      // -------- /users/{uid}/audit/{id} (per-user audit subcollection) --------
      match /audit/{auditId} {
        allow read: if isOwner(userId) || isStaff();
        allow write: if false; // server only via Admin SDK
      }

      // -------- /users/{uid}/giftBlocklist/{senderUid} --------
      // Host-managed blocklist that prevents a specific sender from
      // gifting them. The backend gift-send route reads this inside
      // the gift transaction (assertNotBlockedFromGifting in
      // gift-rate-limit.ts) so the host's block flips effective
      // immediately even when a gift is in flight.
      //
      // The host owns the list — they read + write entries from
      // their stream UI. The doc body is opaque (any document
      // presence blocks the sender, regardless of contents). Staff
      // can read for moderation visibility but cannot bypass the
      // host's intent by writing.
      match /giftBlocklist/{senderUid} {
        allow read: if isOwner(userId) || isStaff();
        allow write: if isOwner(userId);
      }
    }

    // -------- /kyc_submissions/{uid} --------
    // Single-doc per user, doc id == uid, immutable images after submit.
    match /kyc_submissions/{userId} {
      allow read: if isOwner(userId) || isStaff();

      allow create: if isOwner(userId)
        && request.resource.data.status == 'pending'
        && request.resource.data.uid == userId;

      // staff can review/approve/reject KYC for OTHER users only.
      // Self-approval is denied to break the conflict-of-interest path:
      // a staff member who needs to broadcast must have their KYC
      // reviewed by another staff member or an admin, never themselves.
      // uid is still immutable.
      allow update: if isStaff()
        && uid() != userId
        && request.resource.data.uid == resource.data.uid;

      // admin retains full update authority (including for their own
      // submission) so the team can never get locked out of approvals.
      allow update: if isAdmin()
        && request.resource.data.uid == resource.data.uid;

      allow delete: if isAdmin();
    }

    // -------- /streams/{streamId} --------
    // Live streams discoverable by all signed-in users.
    // Lifecycle (create / status flip / end) is server-only via Admin SDK
    // through /api/livekit/token + /api/streams/end. Clients NEVER write here
    // directly — this prevents impersonation, race-condition lifecycles, and
    // bypassing KYC/ban gates.
    match /streams/{streamId} {
      allow read: if isSignedIn();
      allow create: if false;
      allow update: if false;
      allow delete: if false;

      // -------- /streams/{streamId}/chat/{messageId} (subcollection) --------
      // Read-only from the client; writes are denied. There is currently NO
      // backend write path — `POST /api/streams/{id}/chat` does not exist
      // (verify: `ls backend/src/app/api/streams/`). Until that endpoint
      // ships through the Admin SDK with ban-gate + profanity filter +
      // /audit_log integration, the chat subcollection stays empty for
      // every stream and `ChatRepository.observe()` always emits an empty
      // list. The deny rule is kept (rather than relaxed to authed write)
      // because relaxing it would re-introduce the moderation-bypass class
      // closed by PR #53 (gate gifts/wallet against bans) for any future
      // chat-spam attack.
      match /chat/{messageId} {
        allow read: if isSignedIn();
        allow write: if false; // server-only via Admin SDK (endpoint TBD)
      }

      // -------- /streams/{streamId}/gifts/{giftId} (subcollection) --------
      // Per-stream gift transaction log. Written by /api/gifts/send via
      // Admin SDK inside the same Firestore transaction that debits the
      // sender wallet and credits the host wallet. Used by:
      //   - the gift-rate-limit module (server-side cooldown read), and
      //   - moderators investigating gift-fraud reports.
      // Hosts and senders both have legitimate reasons to see "what was
      // sent in my stream" / "what did I send" UIs in the future, so we
      // allow the host (resource.data.receiverUid == uid()) and the
      // sender (resource.data.senderUid == uid()) to read their own
      // entries. The field name MUST stay aligned with the writer in
      // backend/src/app/api/gifts/send/route.ts (`receiverUid: ownerUid`).
      // No client writes — writes go through the gift txn.
      match /gifts/{giftId} {
        allow read: if isStaff()
          || (isSignedIn() && resource.data.receiverUid == uid())
          || (isSignedIn() && resource.data.senderUid == uid());
        allow write: if false; // server-only via Admin SDK
      }

      // -------- /streams/{streamId}/giftRateCounters/{senderUid} (subcollection) --------
      // Per-(stream, sender) rate-limit counter. Maintains two sliding
      // windows (60s + 1h) inside the gift transaction so the
      // 5/60s + 60/hr caps are enforced atomically with the wallet
      // debit (no TOCTOU bypass via concurrent requests). Written
      // exclusively by `assertAndIncrementGiftRate` in
      // backend/src/lib/gift-rate-limit.ts; never surfaced in any UI
      // and never read by a client. Locked client-side to deny ALL
      // access — only the Admin SDK touches these docs.
      //
      // If a client read path is ever desired ("how many gifts have I
      // sent in this stream this hour"), it should go through a new
      // backend endpoint that reads the counter via Admin SDK and
      // returns a sanitised payload — not by relaxing this rule.
      match /giftRateCounters/{senderUid} {
        allow read: if false;
        allow write: if false;
      }
    }

    // -------- /wallets/{uid} --------
    // Per-user wallet (coins + diamonds + lifetime counters). Reads are
    // direct from the Android client (real-time balance updates) and so
    // need an explicit allow — without it, every wallet observe() call
    // hits PERMISSION_DENIED and the UI silently shows a zeroed snapshot
    // courtesy of WalletRepository's error fallback.
    //
    // Writes are server-only: every coin/diamond delta MUST go through
    // the backend (gift txn, top-up, withdrawal) so audit_log + atomic
    // counters stay correct. The Android client never writes here.
    match /wallets/{userId} {
      allow read: if isOwner(userId) || isStaff();
      allow write: if false; // server-only via Admin SDK
    }

    // -------- /audit_log/{id} (system audit log) --------
    match /audit_log/{auditId} {
      allow read: if isStaff();
      allow write: if false; // server only via Admin SDK
    }

    // -------- /metrics/signups/days/{date} (Layla GR5 — daily signup cap) --------
    // Per-day signup counter + carrier breakdown + lock flag. Written
    // exclusively by the Admin SDK via /api/signup/heartbeat (see
    // backend/src/app/api/signup/heartbeat/route.ts). Read by staff via
    // /api/admin/signup-metrics (Admin SDK side too — that endpoint
    // doesn't go through these rules), and direct-read by staff on the
    // Firebase Console for incident response. Direct-read from the
    // Android client is denied to keep enumeration of carrier
    // breakdowns and sign-up volume out of regular-user reach.
    //
    // The rules MAY look more permissive than strictly necessary
    // (`/metrics/{...}` would let us close everything in one match),
    // but spelling out the exact path makes intent obvious for a
    // future audit and prevents accidental leakage if we ever add a
    // sibling collection like `/metrics/active_streams/`.
    match /metrics/{document=**} {
      allow read: if isStaff();
      allow write: if false; // server-only via Admin SDK
    }

    // -------- /audit/{userId}/events/{eventId} (per-user durable audit) --------
    // Layla's T&S guardrail GR2. The Android client writes a single
    // `kyc_bypass_granted` event to this collection on first sign-in
    // when the closed-beta KYC bypass is active (see
    // [com.halqa.app.data.UserDocBootstrap]). The trail is intentionally
    // SEPARATE from `/users/{uid}.bypass_grant` so that even if the user
    // doc is later edited or deleted, the audit survives in its own
    // collection — which is the whole point of an audit log.
    //
    // Why a top-level `/audit/{uid}/events` rather than the existing
    // `/users/{uid}/audit/{id}` subcollection? The existing per-user
    // audit subcoll is server-only-write (Admin SDK gated; line ~101);
    // relaxing it to allow client writes for ANY entry would risk a
    // user planting forged moderator-action audit entries. Carving out
    // a NEW collection with a narrow rule (`type` is a constrained
    // string, `uid` must match the path, no updates, no deletes) gives
    // us the client-write capability we need for the bypass-grant event
    // without weakening the existing locked-down audit subcoll.
    //
    // Constraints (defence in depth — if any of these are violated, the
    // rule rejects, the audit row is missing, and the user-doc-side
    // `bypass_grant` field is still authoritative for the withdrawal
    // gate so we don't lose the safety property):
    //   - owner can create only their own events (`isOwner(userId)`),
    //   - `uid` field MUST match the path segment (no impersonation),
    //   - `type` is a string with `size <= 64` (defeats doc-bloat DoS,
    //     same class as PR #54 streamTitle / #58 KYC fullName cap),
    //   - update + delete forbidden (append-only audit).
    //
    // Reads: owner can see their own audit, staff can read everyone's
    // for incident investigation. No public read.
    match /audit/{userId}/events/{eventId} {
      allow read: if isOwner(userId) || isStaff();
      allow create: if isOwner(userId)
        && request.resource.data.uid == userId
        && request.resource.data.type is string
        && request.resource.data.type.size() <= 64;
      allow update: if false;
      allow delete: if false;
    }

    // -------- /staff_actions/{id} --------
    // Closed-create. Staff actions (warn / mute / ban / kick) MUST go
    // through a server-side backend endpoint that uses the Admin SDK,
    // for the same reason gifts/wallet/streams writes are server-only:
    //
    //   1. The previous rule (`allow create: if isStaff() &&
    //      request.resource.data.staffUid == uid()`) only enforced
    //      staff identity on `staffUid`. Every other field —
    //      `targetUid`, `action`, `reason`, length, shape — was
    //      free-form. A staff member with a tampered SDK client (or
    //      a leaked staff token) could:
    //        a. Plant a fake "you were warned for X" entry against any
    //           targetUid they choose. The read rule (line ~226) lets
    //           the owner read entries where `resource.data.targetUid
    //           == uid()`, so a forged entry surfaces to a moderation
    //           UI or to the user themselves with no audit trail back
    //           to the real moderator's intent.
    //        b. Bloat the doc with multi-megabyte strings —
    //           Firestore's 1MB hard limit, the same doc-bloat DoS
    //           class closed for streamTitle (PR #54), KYC fullName /
    //           documentNumber (PR #58), and chat (forthcoming).
    //        c. Stamp arbitrary timestamps so audit ordering is
    //           untrustworthy.
    //   2. There is currently NO producer for this collection. A
    //      repo-wide grep for `staff_actions` finds matches only in
    //      this file and `firestore.indexes.json`. No backend route,
    //      no Android writer. The collection is empty, so closing
    //      the rule today causes no functional regression.
    //   3. When the moderator-actions endpoint ships, it must:
    //        - validate `targetUid` exists in /users,
    //        - validate `action` against an allow-list ("warn",
    //          "mute", "ban", "unban", "kick"),
    //        - hard-cap string fields (`reason`, `notes`),
    //        - stamp `staffUid` from the auth token (NOT the body),
    //        - mirror an entry into /audit_log so staff actions land
    //          in `GET /api/audit/[uid]` alongside kyc / streams /
    //          gifts / wallet (matches PR #61 + #64 conventions).
    //
    // Reads are unchanged: staff sees everything, the targeted user
    // sees their own entries (so a future "moderation history" screen
    // can render "you were warned on …"). This stays so we don't have
    // to rewrite the rule when the endpoint lands.
    match /staff_actions/{actionId} {
      allow read: if isStaff()
        || (isSignedIn() && resource.data.targetUid == uid());

      allow create: if false; // server-only via Admin SDK (TBD)
      allow update: if false; // server-only via Admin SDK (TBD)
      allow delete: if isAdmin();
    }

    // -------- /bans/{banId} --------
    // Server-only writes (Admin SDK through staff actions API). Clients can
    // only read their own ban + staff can read all.
    match /bans/{banId} {
      allow read: if isStaff()
        || (isSignedIn() && resource.data.userId == uid());

      allow write: if false;
    }
  }
}
